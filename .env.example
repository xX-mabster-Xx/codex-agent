BOT_TOKEN=123456789:replace_me
TELEGRAM_USER_ID=123456789
# Separate BotFather bot used only for root-command approvals.
ROOT_APPROVAL_BOT_TOKEN=
# Empty means TELEGRAM_USER_ID.
ROOT_APPROVAL_TELEGRAM_USER_ID=
PROJECT_DIR=/absolute/path/to/project
PROJECTS_ROOT=/absolute/path/to/telegram-projects
AGENT_TOPIC_NAME=Agent
AGENT_TOPIC_ID=
AGENT_PROJECT_DIR=/absolute/path/to/current/agent/project
# Не задавайте одновременно работающий thread из другого Codex-процесса.
AGENT_THREAD_ID=
# Google Cloud OAuth client (Desktop application) for Workspace MCP.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Only voice messages and audio files are sent to OpenRouter for transcription.
OPENROUTER_API_KEY=
OPENROUTER_AUDIO_MODEL=google/gemini-3.5-flash-lite
# Native Codex subagents inherit the current topic's provider and permissions.
SUBAGENTS_ENABLED=true
SUBAGENTS_MAX_CONCURRENT=3
# Credentials for a custom Codex profile are injected only when that profile
# declares the matching `env_key`.  For ~/.codex/nous.config.toml:
NOUS_API_KEY=
PROXY_URL=socks5://127.0.0.1:2060
# Maximum UTF-8 bytes returned by one Telegram MCP read call.
TELEGRAM_MAX_TOOL_RESULT_BYTES=65536
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
